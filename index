<style>
/* Layout concept: dokumen gim untuk guru. Skala pH (indikator universal) menjadi peta: tiap zona memakai satu warna indikator, dari merah (asam) ke ungu (basa). */
:root {
  --bg: #f4f7f6;
  --surface: #ffffff;
  --surface-2: #eaf1ef;
  --fg: #11241f;
  --muted: #4d625c;
  --line: #d3dfdb;
  --accent: #0b6b6b;
  --on-accent: #ffffff;
  --z1: #cb3535;
  --z2: #b95a0c;
  --z3: #2a8a3d;
  --z4: #2e63c4;
  --zb: #7a3fb8;
  --on-z: #ffffff;
  --ok: #1f7a3a;
  --font-display: "Bricolage Grotesque", "Trebuchet MS", sans-serif;
  --font-body: "Source Sans 3", "Segoe UI", system-ui, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0c1917; --surface: #13262a; --surface-2: #1a3135; --fg: #e4efec; --muted: #9bb2ab;
    --line: #29433f; --accent: #55c9c1; --on-accent: #0c1917;
    --z1: #f07676; --z2: #f2a04e; --z3: #63c77b; --z4: #7ba5f4; --zb: #bb91ea; --on-z: #0c1917; --ok: #6fd08a;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0c1917; --surface: #13262a; --surface-2: #1a3135; --fg: #e4efec; --muted: #9bb2ab;
  --line: #29433f; --accent: #55c9c1; --on-accent: #0c1917;
  --z1: #f07676; --z2: #f2a04e; --z3: #63c77b; --z4: #7ba5f4; --zb: #bb91ea; --on-z: #0c1917; --ok: #6fd08a;
  color-scheme: dark;
}
* { box-sizing: border-box; }
body {
  background: var(--bg); color: var(--fg);
  font-family: var(--font-body); font-size: 17px; line-height: 1.55;
  padding-block: 0 4rem;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--bg); }
.wrap { max-width: 62rem; margin: 0 auto; }
h1, h2, h3 { font-family: var(--font-display); line-height: 1.12; text-wrap: balance; margin: 0; }
h1 { font-size: clamp(2.3rem, 7vw, 4.2rem); font-weight: 800; letter-spacing: -0.02em; }
h2 { font-size: clamp(1.6rem, 4vw, 2.2rem); font-weight: 800; letter-spacing: -0.01em; }
h3 { font-size: 1.2rem; font-weight: 600; }
p { margin: 0; max-width: 65ch; }
sub, sup { font-size: 0.72em; line-height: 0; }
.mono { font-family: var(--font-mono); }
.eyebrow { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }

/* header */
header { padding-block: 2.5rem 1.5rem; display: grid; gap: 1.1rem; }
.lead { font-size: 1.15rem; color: var(--muted); }
.chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.chip { font-family: var(--font-mono); font-size: 0.8rem; padding: 0.3rem 0.65rem; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); }
.phstrip { margin-top: 0.6rem; }
.phbar { height: 14px; border-radius: 3px; background: linear-gradient(90deg, #d93a3a 0%, #e8832a 20%, #e6c53a 38%, #4caf50 50%, #2f9fbf 68%, #2f66c8 82%, #7a3fb8 100%); }
.phticks { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); padding-top: 0.3rem; }

/* nav */
nav.jump { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 11; background: var(--bg); border-bottom: 1px solid var(--line); display: flex; gap: 0.4rem; overflow-x: auto; padding-block: 0.6rem; }
nav.jump button { flex: 0 0 auto; font: inherit; font-size: 0.9rem; color: var(--fg); background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 0.35rem 0.8rem; cursor: pointer; }
nav.jump button:hover { border-color: var(--accent); }
button:focus-visible, summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

section { padding-block: 3rem 0.5rem; display: grid; gap: 1.4rem; scroll-margin-top: 4.5rem; }

/* map */
.story { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 1.3rem 1.4rem; }
.map { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.8rem; position: relative; }
.map::before { content: ""; position: absolute; left: 5%; right: 5%; top: 1.45rem; height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--z1), var(--z2), var(--z3), var(--z4), var(--zb)); }
.map li { position: relative; display: grid; gap: 0.35rem; justify-items: center; text-align: center; min-width: 0; }
