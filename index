.map li b { font-family: var(--font-display); font-size: 1.02rem; line-height: 1.2; }
.map li span { font-size: 0.88rem; color: var(--muted); line-height: 1.35; }

/* zone color hookup */
.c1 { --zc: var(--z1); } .c2 { --zc: var(--z2); } .c3 { --zc: var(--z3); } .c4 { --zc: var(--z4); } .cb { --zc: var(--zb); }

/* tables */
.tablewrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }
table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
th, td { text-align: left; padding: 0.7rem 0.9rem; vertical-align: top; border-bottom: 1px solid var(--line); }
tr:last-child td { border-bottom: 0; }
th { font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); background: var(--surface-2); font-weight: 500; }
td.num, th.num { font-variant-numeric: tabular-nums; white-space: nowrap; }
.zdot { display: inline-block; width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--zc); margin-right: 0.45rem; }

/* toolbar */
.toolbar { display: flex; flex-wrap: wrap; gap: 0.8rem; align-items: center; justify-content: space-between; }
.toggle { font: inherit; font-weight: 600; font-size: 0.95rem; color: var(--on-accent); background: var(--accent); border: 0; border-radius: 6px; padding: 0.55rem 1rem; cursor: pointer; }
.toggle[aria-pressed="true"] { background: var(--fg); color: var(--bg); }

/* zone block */
.zone { display: grid; gap: 1rem; }
.zonehead { display: flex; align-items: center; gap: 0.9rem; padding-bottom: 0.8rem; border-bottom: 2px solid var(--zc); }
.zonehead .node { border-color: var(--bg); flex: 0 0 auto; }
.zonehead p { color: var(--muted); font-size: 0.97rem; }
.qgrid { display: grid; gap: 0.9rem; }
