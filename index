.qtop { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; justify-content: space-between; }
.tag { font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--zc); font-weight: 500; }
.pts { font-family: var(--font-mono); font-size: 0.76rem; color: var(--muted); }
.opts { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
.opts li { display: flex; gap: 0.6rem; }
.opts li > :first-child { font-family: var(--font-mono); font-size: 0.85rem; color: var(--muted); min-width: 1.4rem; padding-top: 0.12rem; }
.box::before { content: "\2610"; font-size: 1.05rem; }
.cards { display: flex; flex-wrap: wrap; gap: 0.45rem; }
.card { font-family: var(--font-mono); font-size: 0.88rem; padding: 0.3rem 0.7rem; background: var(--surface-2); border: 1px dashed var(--muted); border-radius: 5px; }
.blank { color: var(--muted); font-family: var(--font-mono); }
.pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; }
.pair ol, .pair ul { margin: 0; padding-left: 1.3rem; display: grid; gap: 0.2rem; }
.pair h4, .q h4 { margin: 0 0 0.3rem; font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
.steps { margin: 0; padding-left: 1.4rem; display: grid; gap: 0.2rem; }
.work { font-family: var(--font-mono); font-size: 0.9rem; background: var(--surface-2); border-radius: 6px; padding: 0.7rem 0.9rem; display: grid; gap: 0.25rem; }

details.key { border-top: 1px solid var(--line); padding-top: 0.6rem; }
details.key summary { cursor: pointer; font-weight: 600; font-size: 0.93rem; color: var(--accent); list-style: none; display: inline-flex; gap: 0.4rem; align-items: center; }
details.key summary::-webkit-details-marker { display: none; }
details.key summary::before { content: "\25B8"; transition: transform 0.15s; }
details.key[open] summary::before { transform: rotate(90deg); }
details.key .ans { margin-top: 0.55rem; padding: 0.7rem 0.9rem; background: color-mix(in srgb, var(--ok) 12%, var(--surface)); border-radius: 6px; font-size: 0.95rem; display: grid; gap: 0.3rem; }
.ans b { color: var(--ok); }
.note { color: var(--muted); font-size: 0.9rem; }

/* boss */
.boss { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 1.4rem; display: grid; gap: 1.1rem; }
.case { padding: 0.9rem 1.1rem; background: var(--surface-2); border-radius: 6px; }
.fase { display: grid; gap: 0.7rem; }
.fase .q { background: var(--bg); }

/* guide */
.cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1rem; }
.panel { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 1.1rem 1.2rem; display: grid; gap: 0.6rem; align-content: start; min-width: 0; }
.panel ul { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.3rem; }
.timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); overflow: hidden; }
.timeline li { display: grid; grid-template-columns: 6.5rem 1fr auto; gap: 0.8rem; padding: 0.7rem 1rem; border-bottom: 1px solid var(--line); align-items: baseline; }
.timeline li:last-child { border-bottom: 0; }
.timeline .t { font-family: var(--font-mono); font-size: 0.85rem; color: var(--muted); }
.timeline .d { font-family: var(--font-mono); font-size: 0.82rem; color: var(--muted); }
footer { padding-top: 3rem; color: var(--muted); font-size: 0.9rem; }

@media (max-width: 720px) {
  .map { grid-template-columns: 1fr; gap: 1rem; }
  .map::before { left: 1.45rem; right: auto; top: 1.5rem; bottom: 1.5rem; width: 4px; height: auto; background: linear-gradient(180deg, var(--z1), var(--z2), var(--z3), var(--z4), var(--zb)); }
  .map li { grid-template-columns: 2.9rem 1fr; justify-items: start; text-align: left; column-gap: 0.9rem; align-items: center; }
  .map li .node { grid-row: span 2; }
  .pair { grid-template-columns: 1fr; }
  .timeline li { grid-template-columns: 5rem 1fr; }
  .timeline .d { grid-column: 2; }
}
@media (prefers-reduced-motion: reduce) { details.key summary::before { transition: none; } }
</style>

